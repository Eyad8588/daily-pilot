# Copy to .env and fill in. Never commit .env.

# Telegram — create a bot with @BotFather, then run `uv run daily-pilot telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth (Gmail + Calendar). Download the Desktop-app OAuth client JSON here:
GOOGLE_CREDENTIALS_FILE=secrets/google_credentials.json
# Created by `uv run daily-pilot auth google`:
GOOGLE_TOKEN_FILE=secrets/google_token.json

# 0 = dry-run (print instead of send, the default). 1 = live.
DAILY_PILOT_LIVE=0

# Optional overrides
# DAILY_PILOT_MODEL=qwen3.5:4b
# DAILY_PILOT_TIMEZONE=Africa/Cairo
# OLLAMA_URL=http://localhost:11434
